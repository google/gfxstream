#version 450
#include "astc_decompressor.glsl"
#include "common.comp"

precision highp int;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(constant_id = 0) const uint kBlockSizeX = 4;
layout(constant_id = 1) const uint kBlockSizeY = 4;

layout(binding = 0, rgba32ui) readonly uniform WITH_TYPE(uimage) srcImage;
layout(binding = 1, rgba8ui) writeonly uniform WITH_TYPE(uimage) dstImage;

void main() {
    const uvec2 kBlockSize = uvec2(kBlockSizeX, kBlockSizeY);
    uvec2 texelPos = gl_GlobalInvocationID.xy;
    uint layer = gl_GlobalInvocationID.z;
    uvec2 blockPos = texelPos / kBlockSize;
    uvec2 posInBlock = texelPos % kBlockSize;

    uvec4 astcBlock = imageLoad(srcImage, WITH_TYPE(getPos)(ivec3(blockPos, layer))).wzyx;
    astcDecoderInitialize(astcBlock, kBlockSize);
    uvec4 texel = astcDecodeTexel(posInBlock);
    imageStore(dstImage, WITH_TYPE(getPos)(ivec3(texelPos, layer)), texel);
}
