+    'DarwinSync.cpp',
+    'DarwinVirtGpuBlob.cpp',
+    'DarwinVirtGpuBlobMapping.cpp',
+    'DarwinVirtGpuDevice.cpp',
+)
+
+libplatform_virtgpu_darwin = static_library(
+    'platform_virtgpu_darwin',
+    files_libplatform_virtgpu_darwin,
+    cpp_args: gfxstream_guest_args,
+    include_directories: [inc_platform_virtgpu, inc_src, inc_include],
+)
diff --git a/src/gfxstream/guest/platform/meson.build b/src/gfxstream/guest/platform/meson.build
index f173f6e0b92..53f194dee50 100644
--- a/src/gfxstream/guest/platform/meson.build
+++ b/src/gfxstream/guest/platform/meson.build
@@ -13,6 +13,9 @@ if system_has_kms_drm
 elif host_machine.system() == 'windows'
     subdir('windows')
     libplatform_virtgpu += libplatform_virtgpu_windows
+elif host_machine.system() in ['darwin', 'macos', 'ios']
+    subdir('darwin')
+    libplatform_virtgpu += libplatform_virtgpu_darwin
 endif
 
 files_libplatform_virtgpu = files('VirtGpu.cpp')
