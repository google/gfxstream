diff --git a/src/gfxstream/guest/platform/darwin/meson.build b/src/gfxstream/guest/platform/darwin/meson.build
new file mode 100644
index 00000000000..34034a3c81e
--- /dev/null
+++ b/src/gfxstream/guest/platform/darwin/meson.build
@@ -0,0 +1,16 @@
+# Copyright 2026 Mesa3D authors
+# SPDX-License-Identifier: MIT
+
