    defines = DEQP_COMMON_DEFINES,
    includes = [
        "external/vulkancts/framework/vulkan",
        "external/vulkancts/framework/vulkan/generated/vulkan",
        "external/vulkancts/modules/vulkan",
        "external/vulkancts/modules/vulkan/amber",
