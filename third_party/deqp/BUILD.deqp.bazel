filegroup(
    name = "data",
    srcs = [
        "external/vulkancts/mustpass/main/vk-default.txt",
    ] + glob(
        [
            "android/cts/main/vk-main-*.txt",
            "data/**",
            "external/vulkancts/data/**",
            "external/vulkancts/mustpass/main/vk-default/**/*.txt",
        ],
        allow_empty = True,
    ),
)

cc_binary(
    name = "deqp-vk",
    srcs = [
        "framework/platform/tcuMain.cpp",
    ],
    copts = DEQP_CXX_COPTS,
    data = [":data"],
    defines = DEQP_COMMON_DEFINES,
    deps = [
        ":deqp_common",
        ":deqp_vulkancts",
    ],
)
