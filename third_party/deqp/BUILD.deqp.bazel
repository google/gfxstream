load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

DEQP_COMMON_DEFINES = [
    "_XOPEN_SOURCE=600",
    "DE_ASSERT_FAILURE_CALLBACK",
    "DE_MINGW=0",
    "DEQP_HAVE_RENDERDOC_HEADER=0",
    "DEQP_EXCLUDE_VK_VIDEO_TESTS",
    "DEQP_SUPPORT_DRM=0",
    "DEQP_SUPPORT_HEADLESS=1",
    "DEQP_TARGET_NAME=\\\"default\\\"",
    "QP_SUPPORT_PNG",
    "CTS_USES_VULKAN",
]

DEQP_COMMON_COPTS = [
    "-fwrapv",
    "-Wno-implicit-fallthrough",
    "-Wno-sign-conversion",
    "-Wno-unused-private-field",
    "-Wno-shorten-64-to-32",
    "-Wno-unused-function",
    "-Wno-unused-parameter",
    "-Wno-unused-variable",
    "-Wno-missing-field-initializers",
    "-Wno-switch",
    "-Wno-macro-redefined",
]

DEQP_CXX_COPTS = DEQP_COMMON_COPTS + [
    "-std=c++17",
    "-fexceptions",
    "-Wno-non-virtual-dtor",
    "-Wno-delete-non-virtual-dtor",
]

genrule(
    name = "gen_spirv_hpp",
    outs = ["SPIRV/spirv.hpp"],
    cmd = "echo '#include \"spirv/unified1/spirv.hpp\"' > $@",
)

cc_library(
    name = "deqp_vulkan_headers",
    hdrs = glob(
        [
            "external/vulkancts/framework/vulkan/*.hpp",
            "external/vulkancts/framework/vulkan/generated/vulkan/*.h",
            "external/vulkancts/framework/vulkan/generated/vulkan/*.inl",
            "framework/delibs/debase/*.h",
        ],
        allow_empty = True,
    ) + [":gen_spirv_hpp"],
    defines = DEQP_COMMON_DEFINES,
    includes = [
        ".",
        "external/vulkancts/framework/vulkan",
        "external/vulkancts/framework/vulkan/generated/vulkan",
        "framework/delibs/debase",
    ],
)

cc_library(
    name = "deqp_common_c",
    srcs = glob(
        [
            "framework/delibs/debase/*.c",
            "framework/delibs/deimage/*.c",
            "framework/delibs/depool/*.c",
            "framework/delibs/destream/*.c",
            "framework/delibs/dethread/*.c",
            "framework/delibs/dethread/unix/*.c",
            "framework/delibs/deutil/*.c",
            "framework/qphelper/*.c",
        ],
        allow_empty = True,
        exclude = [
            "framework/delibs/dethread/standalone_test.c",
            "framework/delibs/dethread/unix/deSemaphoreMach.c",
        ],
    ),
    hdrs = glob(
        [
            "framework/delibs/debase/*.h",
            "framework/delibs/deimage/*.h",
            "framework/delibs/depool/*.h",
            "framework/delibs/destream/*.h",
            "framework/delibs/dethread/*.h",
            "framework/delibs/dethread/unix/*.h",
            "framework/delibs/deutil/*.h",
            "framework/qphelper/*.h",
            "framework/qphelper/*.inl",
        ],
        allow_empty = True,
    ),
    copts = DEQP_COMMON_COPTS + ["-D_GNU_SOURCE"],
    defines = DEQP_COMMON_DEFINES,
    includes = [
        "framework/delibs/debase",
        "framework/delibs/deimage",
        "framework/delibs/depool",
        "framework/delibs/destream",
        "framework/delibs/dethread",
        "framework/delibs/dethread/unix",
        "framework/delibs/deutil",
        "framework/qphelper",
    ],
    linkopts = [
        "-ldl",
        "-lm",
        "-lpthread",
    ],
    linkstatic = True,
    deps = [
        "@libpng",
        "@zlib",
    ],
)

cc_library(
    name = "deqp_common",
    srcs = glob(
        [
            "execserver/*.cpp",
            "executor/*.cpp",
            "framework/common/*.cpp",
            "framework/delibs/decpp/*.cpp",
            "framework/egl/*.cpp",
            "framework/egl/wrapper/*.cpp",
            "framework/opengl/*.cpp",
            "framework/opengl/simplereference/*.cpp",
            "framework/opengl/wrapper/*.cpp",
            "framework/platform/lnx/*.cpp",
            "framework/randomshaders/*.cpp",
            "framework/referencerenderer/*.cpp",
            "framework/xexml/*.cpp",
        ],
        allow_empty = True,
        exclude = [
            "execserver/xsWin32TestProcess.cpp",
            "framework/randomshaders/rsgTest.cpp",
        ],
    ),
    hdrs = glob(
        [
            "execserver/*.h",
            "execserver/*.hpp",
            "execserver/*.inl",
            "executor/*.h",
            "executor/*.hpp",
            "executor/*.inl",
            "framework/common/*.h",
            "framework/common/*.hpp",
            "framework/common/*.inl",
            "framework/delibs/decpp/*.h",
            "framework/delibs/decpp/*.hpp",
            "framework/delibs/decpp/*.inl",
            "framework/egl/*.h",
            "framework/egl/*.hpp",
            "framework/egl/*.inl",
            "framework/egl/wrapper/*.h",
            "framework/egl/wrapper/*.hpp",
            "framework/egl/wrapper/*.inl",
            "framework/opengl/*.h",
            "framework/opengl/*.hpp",
            "framework/opengl/*.inl",
            "framework/opengl/simplereference/*.h",
            "framework/opengl/simplereference/*.hpp",
            "framework/opengl/simplereference/*.inl",
            "framework/opengl/wrapper/*.h",
            "framework/opengl/wrapper/*.hpp",
            "framework/opengl/wrapper/*.inl",
            "framework/platform/lnx/*.h",
            "framework/platform/lnx/*.hpp",
            "framework/platform/lnx/*.inl",
            "framework/randomshaders/*.h",
            "framework/randomshaders/*.hpp",
            "framework/randomshaders/*.inl",
            "framework/referencerenderer/*.h",
            "framework/referencerenderer/*.hpp",
            "framework/referencerenderer/*.inl",
            "framework/xexml/*.h",
            "framework/xexml/*.hpp",
            "framework/xexml/*.inl",
        ],
        allow_empty = True,
    ),
    copts = DEQP_CXX_COPTS,
    defines = DEQP_COMMON_DEFINES,
    includes = [
        "execserver",
        "executor",
        "framework/common",
        "framework/delibs/decpp",
        "framework/egl",
        "framework/egl/wrapper",
        "framework/opengl",
        "framework/opengl/simplereference",
        "framework/opengl/wrapper",
        "framework/platform/lnx",
        "framework/randomshaders",
        "framework/referencerenderer",
        "framework/xexml",
    ],
    linkstatic = True,
    deps = [
        ":deqp_common_c",
        ":deqp_vulkan_headers",
        "@//third_party/opengl:gfxstream_egl_headers",
        "@//third_party/opengl:gfxstream_gles3_headers",
    ],
)

cc_library(
    name = "deqp_vulkancts",
    srcs = glob(
        [
            "external/vulkancts/framework/vulkan/**/*.cpp",
            "external/vulkancts/modules/vulkan/**/*.cpp",
        ],
        allow_empty = True,
        exclude = [
            "external/vulkancts/framework/vulkan/vkRenderDocUtil.cpp",
            "external/vulkancts/modules/vulkan/sc/**",
            "external/vulkancts/modules/vulkan/video/**",
            "external/vulkancts/modules/vulkan/vktBuildPrograms.cpp",
            "external/vulkancts/modules/vulkan/vktTestPackageEntrySC.cpp",
