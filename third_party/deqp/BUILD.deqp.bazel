    ),
    hdrs = glob(
        [
            "external/vulkancts/framework/vulkan/**/*.h",
            "external/vulkancts/framework/vulkan/**/*.hpp",
            "external/vulkancts/framework/vulkan/**/*.inl",
            "external/vulkancts/modules/vulkan/**/*.h",
            "external/vulkancts/modules/vulkan/**/*.hpp",
