load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

DEFINES = [
    "VK_ENABLE_BETA_EXTENSIONS",
] + select({
    "@platforms//os:linux": [
        "VK_USE_PLATFORM_XLIB_KHR",
        "VK_USE_PLATFORM_XCB_KHR",
        "VK_USE_PLATFORM_WAYLAND_KHR",
    ],
    "@platforms//os:macos": [
        "VK_USE_PLATFORM_METAL_EXT",
        "VK_USE_PLATFORM_MACOS_MVK",
    ],
    "@platforms//os:windows": [
        "WIN32",
        "_WIN32",
        "VK_USE_PLATFORM_WIN32_KHR",
        "NOMINMAX",
        "WIN32_LEAN_AND_MEAN",
        "_CRT_SECURE_NO_WARNINGS",
    ],
    "//conditions:default": [],
})

cc_library(
    name = "vulkan_utility_headers",
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
    ]),
    defines = DEFINES,
    includes = ["include"],
    deps = [
        "@gfxstream//third_party/vulkan:vulkan_headers",
    ],
)

cc_library(
    name = "vulkan_layer_settings",
    srcs = [
        "src/layer/layer_settings_manager.cpp",
        "src/layer/layer_settings_manager.hpp",
        "src/layer/layer_settings_util.cpp",
        "src/layer/layer_settings_util.hpp",
        "src/layer/vk_layer_settings.cpp",
        "src/layer/vk_layer_settings_helper.cpp",
    ],
    hdrs = glob([
        "include/vulkan/layer/**/*.h",
        "include/vulkan/layer/**/*.hpp",
    ]),
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": [
            "-std=c++17",
            "-Wno-conversion",
            "-Wno-implicit-fallthrough",
            "-Wno-unused-function",
        ],
    }),
    defines = DEFINES,
    includes = [
        "include",
        "src/layer",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:advapi32.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":vulkan_utility_headers",
        "@gfxstream//third_party/vulkan:vulkan_headers",
    ],
)

cc_library(
    name = "vulkan_safe_struct",
    srcs = [
        "src/vulkan/vk_safe_struct_core.cpp",
        "src/vulkan/vk_safe_struct_ext.cpp",
        "src/vulkan/vk_safe_struct_khr.cpp",
        "src/vulkan/vk_safe_struct_manual.cpp",
        "src/vulkan/vk_safe_struct_utils.cpp",
        "src/vulkan/vk_safe_struct_vendor.cpp",
    ],
    hdrs = glob([
        "include/vulkan/utility/**/*.hpp",
    ]),
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": [
            "-std=c++17",
            "-Wno-conversion",
            "-Wno-implicit-fallthrough",
            "-Wno-unused-function",
        ],
    }),
    defines = DEFINES,
    includes = ["include"],
    deps = [
        ":vulkan_utility_headers",
        "@gfxstream//third_party/vulkan:vulkan_headers",
    ],
)

cc_library(
    name = "vulkan_utility_libraries",
    deps = [
        ":vulkan_layer_settings",
        ":vulkan_safe_struct",
        ":vulkan_utility_headers",
    ],
)
