load("@rules_license//rules:license.bzl", "license")

package_group(
    name = "gfxstream",
    packages = [
        "//...",
    ],
)

package(
    default_applicable_licenses = [":gfxstream_license"],
    default_visibility = ["//:gfxstream"],
)

exports_files(
    ["LICENSE"],
    visibility = ["//visibility:public"],
)

license(
    name = "gfxstream_license",
    package_name = "gfxstream",
    copyright_notice = "Copyright 2024 - The Android Open Source Project",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
        "@rules_license//licenses/spdx:BSD-3-Clause",
        "@rules_license//licenses/spdx:ISC",
        "@rules_license//licenses/spdx:MIT",
    ],
    license_text = "LICENSE",
    package_url = "https://android.googlesource.com/platform/hardware/google/gfxstream/",
    visibility = ["//visibility:public"],
)

licenses(["notice"])

test_suite(
    name = "gfxstream_unit_tests",
    tests = [
        "//codegen/generic-apigen:parser_test",
        "//common/base:gfxstream_common_base_tests",
        "//host:gfxstream_framebuffer_tests",
        "//host:gfxstream_unittest",
        "//host:gfxstream_virtio_gpu_timelines_tests",
        "//host:gfxstream_vsyncthread_tests",
        "//host/address_space:gfxstream_host_address_space_tests",
        "//host/compressed_textures:gfxstream_host_compressed_textures_unittests",
        "//host/features:gfxstream_features_tests",
        "//host/renderdoc:gfxstream_host_renderdoc_tests",
        "//host/tests:gfxstream_glsnapshot_tests",
        "//host/vulkan:gfxstream_compositorvk_tests",
        "//host/vulkan:gfxstream_device_op_tracker_tests",
        "//host/vulkan:gfxstream_displayvk_tests",
        "//host/vulkan:gfxstream_emulatedphysicalmemory_tests",
        "//host/vulkan:gfxstream_emulatedphysicalqueue_tests",
        "//host/vulkan:gfxstream_swap_chain_state_vk_tests",
        "//host/vulkan:gfxstream_vk_decoder_global_state_tests",
        "//host/vulkan:gfxstream_vk_decoder_snapshot_utils_tests",
        "//host/vulkan:gfxstream_vk_format_utils_tests",
        "//host/vulkan:gfxstream_vk_qsri_timeline_tests",
        "//host/vulkan:gfxstream_vk_utils_tests",
        "//host/vulkan:gfxstream_vulkan_tests",
        "//host/vulkan:vk_common_operations_tests",
        "//host/vulkan:vk_format_utils_tests",
    ],
    visibility = ["//visibility:public"],
)
