load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_applicable_licenses = ["//:gfxstream_license"],
    default_visibility = ["//:gfxstream"],
)

string_flag(
    name = "graphics_test_environment",
    build_setting_default = "host",
    values = [
        "host",
        "gles_none_vulkan_lavapipe",
        "gles_angle_vulkan_lavapipe",
        "gles_angle_vulkan_swiftshader",
    ],
    visibility = ["//visibility:public"],
)

# Mark the driver filegroups and label_flags with `tags = ["manual"]` so that
# top-level wildcard builds (e.g. `bazel build ...`) do not unconditionally
# build ANGLE or Lavapipe when another `--graphics_drivers` mode is active.
# `tags = ["manual"]` only excludes targets from top-level wildcard expansion
# (`...`, `:*`, `:all`) and still builds them normally when depended upon
# through the active `select()` branch in `graphics_test_environment_drivers`:
# https://bazel.build/reference/be/common-definitions#common.tags

filegroup(
    name = "default_gles_angle_drivers",
    srcs = [
        "//third_party/angle:libEGL_angle_vendor_icd.json",
        "@angle//:libEGL",
        "@angle//:libGLESv2",
    ],
    tags = ["manual"],
)

label_flag(
    name = "gles_angle_drivers",
    build_setting_default = ":default_gles_angle_drivers",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "default_vulkan_lavapipe_drivers",
    srcs = [
        "//third_party/mesa:vk_lavapipe_icd.json",
        "@mesa//:vulkan_lvp",
    ],
    tags = ["manual"],
)

label_flag(
    name = "vulkan_lavapipe_drivers",
    build_setting_default = ":default_vulkan_lavapipe_drivers",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "graphics_test_environment_host",
    flag_values = {
        ":graphics_test_environment": "host",
    },
)

config_setting(
    name = "graphics_test_environment_gles_none_vulkan_lavapipe",
    flag_values = {
        ":graphics_test_environment": "gles_none_vulkan_lavapipe",
    },
)

config_setting(
    name = "graphics_test_environment_gles_angle_vulkan_lavapipe",
    flag_values = {
        ":graphics_test_environment": "gles_angle_vulkan_lavapipe",
    },
)

config_setting(
    name = "graphics_test_environment_gles_angle_vulkan_swiftshader",
    flag_values = {
        ":graphics_test_environment": "gles_angle_vulkan_swiftshader",
    },
)

copy_to_directory(
    name = "graphics_test_environment_drivers",
    srcs = select({
        ":graphics_test_environment_gles_none_vulkan_lavapipe": [
            ":vulkan_lavapipe_drivers",
        ],
        ":graphics_test_environment_gles_angle_vulkan_lavapipe": [
            ":gles_angle_drivers",
            ":vulkan_lavapipe_drivers",
        ],
        ":graphics_test_environment_gles_angle_vulkan_swiftshader": [
            ":gles_angle_drivers",
            "//third_party/swiftshader:vk_swiftshader_icd.json",
            "@swiftshader//:vk_swiftshader",
        ],
        "//conditions:default": [
            # Default does not change anything and uses host drivers.
        ],
    }),
    include_external_repositories = ["*"],
    # Effectively, all of the "prefixes" to flatten/strip.
    root_paths = [
        "**/darwin-aarch64/lib",
        "**/lib64/vulkan",
        "**/linux-x86_64/lib",
        "common/testenv",
        "third_party/angle",
        "third_party/mesa",
        "third_party/swiftshader",
    ],
)

cc_library(
    name = "graphics_test_environment_support",
    testonly = True,
    srcs = [
        "graphics_test_environment.cpp",
    ],
    hdrs = [
        "include/gfxstream/common/testing/graphics_test_environment.h",
    ],
    data = select({
        ":graphics_test_environment_gles_none_vulkan_lavapipe": [
            ":graphics_test_environment_drivers",
        ],
        ":graphics_test_environment_gles_angle_vulkan_lavapipe": [
            ":graphics_test_environment_drivers",
        ],
        ":graphics_test_environment_gles_angle_vulkan_swiftshader": [
            ":graphics_test_environment_drivers",
        ],
        "//conditions:default": [],
    }),
    defines = select({
        ":graphics_test_environment_gles_none_vulkan_lavapipe": [
            "GFXSTREAM_TESTING_USE_VULKAN_LAVAPIPE",
        ],
        ":graphics_test_environment_gles_angle_vulkan_lavapipe": [
            "GFXSTREAM_TESTING_USE_GLES_ANGLE",
            "GFXSTREAM_TESTING_USE_VULKAN_LAVAPIPE",
        ],
        ":graphics_test_environment_gles_angle_vulkan_swiftshader": [
            "GFXSTREAM_TESTING_USE_GLES_ANGLE",
            "GFXSTREAM_TESTING_USE_VULKAN_SWIFTSHADER",
        ],
        "//conditions:default": [
            # Default does not change anything and uses host drivers.
        ],
    }),
    # Linked into the test binary so its sanitizer hooks (e.g.
    # __tsan_default_suppressions) override the runtime's weak defaults.
    linkstatic = True,
    strip_include_prefix = "include",
    deps = select({
        ":graphics_test_environment_gles_none_vulkan_lavapipe": [
            "@rules_cc//cc/runfiles",
        ],
        ":graphics_test_environment_gles_angle_vulkan_lavapipe": [
            "@rules_cc//cc/runfiles",
        ],
        ":graphics_test_environment_gles_angle_vulkan_swiftshader": [
            "@rules_cc//cc/runfiles",
        ],
        "//conditions:default": [],
    }) + [
        "//common/base:gfxstream_common_base",
        "//common/logging:gfxstream_common_logging",
    ],
    alwayslink = True,
)
